# Local application settings
APP_ENV=development
DATABASE_PATH=./data/living_runbook.db
SESSION_SECRET=replace-with-a-long-random-value
SESSION_HTTPS_ONLY=true

# lax works for a single-origin local run. A frontend and backend on different
# sites (Vercel + Render) requires none, because the session cookie must be sent
# on cross-site requests.
SESSION_SAME_SITE=lax
CORS_ORIGINS=[]

# Read by `python -m app.cli.seed_demo_users`. Both are required to seed, and
# re-seeding overwrites the stored hashes. Use throwaway demo values only: the
# seeded accounts are published in this project's pinned issue.
DEMO_EDITOR_PASSWORD=
DEMO_APPROVER_PASSWORD=
