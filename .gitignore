.env
.env.*
!.env.example

# Local virtual environments. The pattern also covers renamed copies such as
# .venv-old-backup, which would otherwise show up as thousands of untracked
# files and could be committed by an accidental `git add .`.
.venv*/
__pycache__
*.pyc

node_modules
dist
build

*.db
*.sqlite
*.sqlite3

.pytest_cache
.ruff_cache
coverage

.DS_Store
*.egg-info/
